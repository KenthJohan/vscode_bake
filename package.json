{
  "name": "bake-projects",
  "displayName": "Bake Projects",
  "description": "Browse Bake projects installed in your home directory.",
  "version": "0.0.73",
  "publisher": "bake-projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KenthJohan/vscode_bake.git"
  },
  "bugs": {
    "url": "https://github.com/KenthJohan/vscode_bake/issues"
  },
  "homepage": "https://github.com/KenthJohan/vscode_bake#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:bakeProjects.explorer",
    "onCommand:bakeProjects.setCurrentProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Bake Projects",
      "properties": {
        "bakeProjects.buildTool": {
          "type": "string",
          "enum": [
            "bake",
            "bake3"
          ],
          "default": "bake",
          "description": "The Bake build tool to use when running project commands."
        },
        "bakeProjects.directory": {
          "type": "string",
          "default": "bake3",
          "description": "The name of the Bake directory under your home directory that contains the 'meta' folder (e.g. bake or bake3)."
        },
        "bakeProjects.ldLibraryPath": {
          "type": "string",
          "default": "",
          "description": "The LD_LIBRARY_PATH used to locate libraries (e.g. ${workspaceFolder}/bin/x64-Linux-debug:${env:HOME}/bake3/x64-Linux/debug/lib/:/usr/local/lib/)."
        },
        "bakeProjects.systemLibraryPath": {
          "type": "string",
          "default": "/usr/local/lib:/usr/lib:/lib:/usr/lib64:/lib64:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:/usr/lib/aarch64-linux-gnu:/lib/aarch64-linux-gnu:/usr/lib/arm-linux-gnueabihf:/lib/arm-linux-gnueabihf",
          "description": "System library search paths separated by colons used as fallback when locating libraries (e.g. /usr/lib/x86_64-linux-gnu:/usr/lib)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bakeProjects",
          "title": "Bake Projects",
          "icon": "resources/bake.svg"
        }
      ]
    },
    "views": {
      "bakeProjects": [
        {
          "id": "bakeProjects.explorer",
          "name": "Installed Projects"
        }
      ]
    },
    "commands": [
      {
        "command": "bakeProjects.refresh",
        "title": "Refresh Bake Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "bakeProjects.open",
        "title": "Open Bake Project"
      },
      {
        "command": "bakeProjects.openLibraryFolder",
        "title": "Open Folder"
      },
      {
        "command": "bakeProjects.openLibrarySymbol",
        "title": "Open Library Symbol"
      },
      {
        "command": "bakeProjects.openTestSuiteFile",
        "title": "Open Test Suite File"
      },
      {
        "command": "bakeProjects.openTestCaseFile",
        "title": "Open Test Case"
      },
      {
        "command": "bakeProjects.openPathInOS",
        "title": "Open Folder in OS"
      },
      {
        "command": "bakeProjects.run",
        "title": "Bake: Run",
        "icon": "$(play)"
      },
      {
        "command": "bakeProjects.test",
        "title": "Bake: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "bakeProjects.addTestSuite",
        "title": "Bake: Add Test Suite",
        "icon": "$(add)"
      },
      {
        "command": "bakeProjects.addTestCase",
        "title": "Bake: Add Test Case",
        "icon": "$(add)"
      },
      {
        "command": "bakeProjects.removeTestSuite",
        "title": "Bake: Remove Test Suite",
        "icon": "$(trash)"
      },
      {
        "command": "bakeProjects.buildRecursive",
        "title": "Bake: Build Recursive",
        "icon": "$(tools)"
      },
      {
        "command": "bakeProjects.rebuild",
        "title": "Bake: Rebuild",
        "icon": "$(sync)"
      },
      {
        "command": "bakeProjects.rebuildRecursive",
        "title": "Bake: Rebuild Recursive",
        "icon": "$(sync)"
      },
      {
        "command": "bakeProjects.uninstall",
        "title": "Bake: Uninstall",
        "icon": "$(trash)"
      },
      {
        "command": "bakeProjects.setCurrentProject",
        "title": "Bake: Set as Current Project",
        "icon": "$(star-full)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bakeProjects.refresh",
          "when": "view == bakeProjects.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "bakeProjects.open",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "navigation"
        },
        {
          "command": "bakeProjects.openLibraryFolder",
          "when": "view == bakeProjects.explorer && viewItem == bakeLibrary",
          "group": "navigation"
        },
        {
          "command": "bakeProjects.openTestSuiteFile",
          "when": "view == bakeProjects.explorer && viewItem == bakeTestSuite",
          "group": "navigation"
        },
        {
          "command": "bakeProjects.addTestCase",
          "when": "view == bakeProjects.explorer && viewItem == bakeTestSuite",
          "group": "navigation@2"
        },
        {
          "command": "bakeProjects.addTestCase",
          "when": "view == bakeProjects.explorer && viewItem == bakeTestSuite",
          "group": "inline@1"
        },
        {
          "command": "bakeProjects.removeTestSuite",
          "when": "view == bakeProjects.explorer && viewItem == bakeTestSuite",
          "group": "inline@2"
        },
        {
          "command": "bakeProjects.openPathInOS",
          "when": "view == bakeProjects.explorer && viewItem == bakeLibraryPathItem",
          "group": "navigation"
        },
        {
          "command": "bakeProjects.addTestSuite",
          "when": "view == bakeProjects.explorer && (viewItem == bakeTests || viewItem == bakeProject)",
          "group": "navigation@2"
        },
        {
          "command": "bakeProjects.addTestSuite",
          "when": "view == bakeProjects.explorer && viewItem == bakeTests",
          "group": "inline@1"
        },
        {
          "command": "bakeProjects.run",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@1"
        },
        {
          "command": "bakeProjects.test",
          "when": "view == bakeProjects.explorer && viewItem == bakeTests",
          "group": "inline@2"
        },
        {
          "command": "bakeProjects.buildRecursive",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@3"
        },
        {
          "command": "bakeProjects.rebuild",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@4"
        },
        {
          "command": "bakeProjects.rebuildRecursive",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@5"
        },
        {
          "command": "bakeProjects.uninstall",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@6"
        }
      ],
      "explorer/context": [
        {
          "command": "bakeProjects.setCurrentProject",
          "when": "resourceFilename == project.json",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package",
    "package:install": "bash scripts/package-vsix.sh patch"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
