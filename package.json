{
  "name": "bake-projects",
  "displayName": "Bake Projects",
  "description": "Browse Bake projects installed in your home directory.",
  "version": "0.0.40",
  "publisher": "bake-projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KenthJohan/vscode_bake.git"
  },
  "bugs": {
    "url": "https://github.com/KenthJohan/vscode_bake/issues"
  },
  "homepage": "https://github.com/KenthJohan/vscode_bake#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:bakeProjects.explorer",
    "onCommand:bakeProjects.setCurrentProject"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Bake Projects",
      "properties": {
        "bakeProjects.buildTool": {
          "type": "string",
          "enum": [
            "bake",
            "bake3"
          ],
          "default": "bake",
          "description": "The Bake build tool to use when running project commands."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bakeProjects",
          "title": "Bake Projects",
          "icon": "resources/bake.svg"
        }
      ]
    },
    "views": {
      "bakeProjects": [
        {
          "id": "bakeProjects.explorer",
          "name": "Installed Projects"
        }
      ]
    },
    "commands": [
      {
        "command": "bakeProjects.refresh",
        "title": "Refresh Bake Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "bakeProjects.open",
        "title": "Open Bake Project"
      },
      {
        "command": "bakeProjects.run",
        "title": "Bake: Run",
        "icon": "$(play)"
      },
      {
        "command": "bakeProjects.buildRecursive",
        "title": "Bake: Build Recursive",
        "icon": "$(tools)"
      },
      {
        "command": "bakeProjects.rebuild",
        "title": "Bake: Rebuild",
        "icon": "$(sync)"
      },
      {
        "command": "bakeProjects.rebuildRecursive",
        "title": "Bake: Rebuild Recursive",
        "icon": "$(sync)"
      },
      {
        "command": "bakeProjects.uninstall",
        "title": "Bake: Uninstall",
        "icon": "$(trash)"
      },
      {
        "command": "bakeProjects.setCurrentProject",
        "title": "Bake: Set as Current Project",
        "icon": "$(star-full)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bakeProjects.refresh",
          "when": "view == bakeProjects.explorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "bakeProjects.open",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "navigation"
        },
        {
          "command": "bakeProjects.run",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@1"
        },
        {
          "command": "bakeProjects.buildRecursive",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@2"
        },
        {
          "command": "bakeProjects.rebuild",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@3"
        },
        {
          "command": "bakeProjects.rebuildRecursive",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@4"
        },
        {
          "command": "bakeProjects.uninstall",
          "when": "view == bakeProjects.explorer && viewItem == bakeProject",
          "group": "inline@5"
        }
      ],
      "explorer/context": [
        {
          "command": "bakeProjects.setCurrentProject",
          "when": "resourceFilename == project.json",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package",
    "package:install": "bash scripts/package-vsix.sh patch"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
